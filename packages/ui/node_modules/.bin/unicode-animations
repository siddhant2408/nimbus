#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules/unicode-animations/scripts/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules/unicode-animations/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules/unicode-animations/scripts/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules/unicode-animations/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/unicode-animations@1.0.3/node_modules:/Users/siddhant/mystuff/ai/agentic-ai/nimbus/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../unicode-animations/scripts/demo.cjs" "$@"
else
  exec node  "$basedir/../unicode-animations/scripts/demo.cjs" "$@"
fi
